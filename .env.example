# Copier ce fichier en .env puis adapter les valeurs.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-en-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Base de données : SQLite en dev, PostgreSQL en prod
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://kora:motdepasse@localhost:5432/kora

# E-mail (console en dev ; en prod : API Brevo recommandée, le SMTP sortant est
# bloqué sur le plan gratuit de Render et de nombreux hébergeurs)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Kora <no-reply@kora.cm>
# Option 1 — API Brevo (300 e-mails/jour gratuits, sans carte, passe par le port 443) :
# EMAIL_BACKEND=apps.core.email_backends.BrevoEmailBackend
# BREVO_API_KEY=xkeysib-...
# DEFAULT_FROM_EMAIL=Kora <albertngaba@gmail.com>
# Option 2 — SMTP classique (fonctionne en local, sur Railway, etc.) :
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=albertngaba@gmail.com
# EMAIL_HOST_PASSWORD=abcdefghijklmnop (mot de passe d'application)

# Numéro WhatsApp de support (format international sans +)
SUPPORT_WHATSAPP=237600000000

# Réseaux sociaux (laisser vide pour masquer l'icône dans le pied de page)
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
SOCIAL_YOUTUBE=

# Fournisseur SMS (OTP). "console" affiche le code dans le terminal.
SMS_BACKEND=console

# Uploads
UPLOAD_MAX_MB=5
PORTFOLIO_MAX_ITEMS=20

# Sécurité (production)
SECURE_SSL_REDIRECT=False

# Déploiement Cloud (Render / Railway)
# RENDER_EXTERNAL_HOSTNAME=kora-app.onrender.com
# RAILWAY_PUBLIC_DOMAIN=kora-production.up.railway.app
# SEED_DEMO=true
