{
  "name": "kora-front",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "css:build": "tailwindcss -i ./static/src/input.css -o ./static/css/app.css --minify",
    "css:watch": "tailwindcss -i ./static/src/input.css -o ./static/css/app.css --watch",
    "vendor": "node scripts/copy-vendor.js",
    "build": "npm run vendor && npm run css:build"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.1.0",
    "@tailwindcss/forms": "^0.5.9",
    "alpinejs": "^3.14.3",
    "chart.js": "^4.4.6",
    "htmx.org": "^2.0.3",
    "lucide": "^0.460.0",
    "tailwindcss": "^3.4.15"
  }
}
